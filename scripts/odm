#!/bin/bash
# OpenDuck Mini 원스톱 — 학습 / 재생 / 측정을 명령 하나로.
#
# 그동안 랩PC에서 매번 ~/lt25.sh 같은 일회용 런처를 만들어 쓰다 보니
# 어떤 체크포인트를 어떤 태스크로 열어야 하는지가 매번 헷갈렸다.
# (러너 설정이 안 맞아 512 네트워크 체크포인트를 256으로 로드하려다
#  터진 적도 있다.) 여기서는 버전 이름만 대면 태스크가 자동으로 붙는다.
set -euo pipefail

PROJ="/media/parksuho/Extreme SSD/parksuho/open_duck_mini_isaaclab"
IL="$HOME/Desktop/IsaacLab/isaaclab.sh"
LOGROOT="$PROJ/logs/rsl_rl/open_duck_mini_v2_joystick"
RUNLOG="$HOME/odm_logs"; mkdir -p "$RUNLOG"

# 버전 -> 태스크. 체크포인트를 학습시킨 설정과 다르면 관측 차원이나
# 네트워크 크기가 어긋나 로드가 실패한다.
task_of() {
  case "$1" in
    v13) echo "Isaac-OpenDuckMini-Joystick-Walk3-v0" ;;
    v17) echo "Isaac-OpenDuckMini-Joystick-Walk6-v0" ;;
    v20*|v24) echo "Isaac-OpenDuckMini-Joystick-Walk9G97-v0" ;;
    v25|v26|path) echo "Isaac-OpenDuckMini-Joystick-Path-v0" ;;
    v27|grav) echo "Isaac-OpenDuckMini-Joystick-Grav-v0" ;;
    v28|tall) echo "Isaac-OpenDuckMini-Joystick-Tall-v0" ;;
    v29|sym) echo "Isaac-OpenDuckMini-Joystick-Sym-v0" ;;
    v30|taller) echo "Isaac-OpenDuckMini-Joystick-Taller-v0" ;;
    v31|hiplimit) echo "Isaac-OpenDuckMini-Joystick-HipLimit-v0" ;;
    v32|hipinward) echo "Isaac-OpenDuckMini-Joystick-HipInward-v0" ;;
    v33|zneck) echo "Isaac-OpenDuckMini-Joystick-ZNeck-v0" ;;
    v33n) echo "Isaac-OpenDuckMini-Joystick-V33N-v0" ;;
    v34c) echo "Isaac-OpenDuckMini-Joystick-V34C-v0" ;;
    v34c10) echo "Isaac-OpenDuckMini-Joystick-V34C10-v0" ;;
    v34c20) echo "Isaac-OpenDuckMini-Joystick-V34C20-v0" ;;
    v34c2) echo "Isaac-OpenDuckMini-Joystick-V34C2-v0" ;;
    # 안전 필터를 켠 변형. 정책은 같고 환경만 다르므로 체크포인트는 원본 것을 쓴다
    # (아래 ckpt_ver 참조). 실기 후보 조합이 v32s 다.
    v28s) echo "Isaac-OpenDuckMini-Joystick-TallSafe-v0" ;;
    v32s|safe) echo "Isaac-OpenDuckMini-Joystick-HipInwardSafe-v0" ;;
    *) echo "" ;;
  esac
}
# pipefail 탓에, 런이 없어 ls가 실패하면 파이프라인 전체가 실패로 잡히고
# set -e가 "체크포인트 없음" 안내에 닿기도 전에 스크립트를 조용히 죽인다.
# 없으면 빈 문자열을 정상 결과로 돌려주고, 판단은 호출부에 맡긴다.
latest_run() { ls -dt "$LOGROOT"/*"$1"* 2>/dev/null | head -1 || true; }
# 필터 변형(vNs)은 자기 런이 없다 -- 같은 정책을 다른 환경에서 돌리는 것이라
# 체크포인트는 원본 버전에서 가져온다.
ckpt_ver() {
  case "$1" in
    v28s) echo v28 ;;
    v32s|safe) echo v32 ;;
    *) echo "$1" ;;
  esac
}

latest_ckpt() {
  local r; r="$(latest_run "$(ckpt_ver "$1")")"
  [ -n "$r" ] || return 0
  ls -t "$r"/model_*.pt 2>/dev/null | head -1 || true
}

# WebRTC는 접속자가 실제로 쓰는 주소를 publicEndpointAddress로 알려줘야 붙는다.
# 이 PC는 유선(192.168.55.x, 기본 경로)과 무선(192.168.137.x, 맥 쪽) 둘 다 있고
# 시청은 무선 쪽에서 하므로 기본 경로 기준으로 고르면 틀린다. 무선을 우선하되
# 다른 데서 볼 때는 ODM_HOST_IP로 덮어쓴다.
host_ip() {
  if [ -n "${ODM_HOST_IP:-}" ]; then echo "$ODM_HOST_IP"; return; fi
  local ips; ips="$(hostname -I)"
  for ip in $ips; do case "$ip" in 192.168.137.*) echo "$ip"; return ;; esac; done
  echo "$ips" | awk '{print $1}'
}

gpu_busy() { [ "$(ps aux | grep -c '[t]rain.py')" -gt 0 ] || [ "$(ps aux | grep -c '[p]lay_fixed')" -gt 0 ]; }
require_free_gpu() {
  if gpu_busy; then
    echo "!! GPU에 Isaac Sim이 이미 떠 있습니다. 두 개를 동시에 띄우면 한쪽이 조용히 죽습니다." >&2
    echo "   'odm stop' 으로 정리한 뒤 다시 실행하세요." >&2
    exit 1
  fi
}

cmd="${1:-help}"; shift || true

case "$cmd" in
train)
  ver="${1:-v26}"; iters="${2:-3000}"; envs="${3:-4096}"
  task="$(task_of "$ver")"; [ -z "$task" ] && { echo "알 수 없는 버전 $ver" >&2; exit 1; }
  require_free_gpu
  cd "$PROJ"
  setsid nohup "$IL" -p scripts/_isaaclab_launch.py \
    "$HOME/Desktop/IsaacLab/scripts/reinforcement_learning/rsl_rl/train.py" \
    --task "$task" --num_envs "$envs" --max_iterations "$iters" \
    --headless --run_name "imitation_$ver" \
    > "$RUNLOG/train_$ver.log" 2>&1 < /dev/null &
  echo "학습 시작: $ver ($task, envs=$envs, iters=$iters)"
  echo "로그: $RUNLOG/train_$ver.log     진행: odm watch $ver"
  ;;

play)
  ver="${1:-v25}"; shift || true
  task="$(task_of "$ver")"; ck="$(latest_ckpt "$ver")"
  [ -z "$task" ] && { echo "알 수 없는 버전 $ver" >&2; exit 1; }
  [ -z "$ck" ] && { echo "체크포인트 없음: $ver" >&2; exit 1; }
  require_free_gpu
  # 기본은 이 PC 모니터에 뜨는 네트워크 없는 네이티브 창. WebRTC는 랩PC 시절
  # 화면이 없어서 쓰던 우회로였고, 지연·화질·publicEndpointAddress 문제를
  # 전부 안고 있었다. 원격에서 띄워도 창은 로컬 X 세션(:0)에 뜬다.
  mode=native
  if [ "${1:-}" = "--stream" ]; then mode=stream; shift; fi

  if [ "$mode" = native ]; then
    render=(); export DISPLAY=:0
  else
    ip="$(host_ip)"
    render=(--livestream 2 --kit_args "--/app/livestream/publicEndpointAddress=$ip")
  fi

  cd "$PROJ"
  setsid nohup "$IL" -p scripts/_isaaclab_launch.py scripts/play_fixed_cmd.py \
    --task "$task" --checkpoint "$ck" --num_envs 1 \
    --cycle --hold 8 --overlay --hud "${render[@]}" "$@" \
    > "$RUNLOG/play_$ver.log" 2>&1 < /dev/null &
  echo "재생 시작: $ver  $(basename "$ck")"
  if [ "$mode" = native ]; then
    echo "  이 PC 모니터에 창이 뜹니다 (부팅 1~2분)."
  else
    echo "  http://$ip:8011/streaming/webrtc-client"
  fi
  echo "  (정지/전진/후진/좌/우/회전 8초씩 순환, 외란 없음)"
  ;;

measure)
  # 두 번째 인자로 iteration 을 주면 그 체크포인트를 잰다: odm measure v27 1500
  # 왜 필요한가: v26 이 v25@1500 보다 두 배 학습하고도 추종이 나빠졌다. 학습량이
  # 다르면 비교가 성립하지 않으므로, 같은 iteration 끼리 재야 한다.
  ver="${1:-v25}"; iter="${2:-}"; task="$(task_of "$ver")"
  [ -z "$task" ] && { echo "알 수 없는 버전 $ver" >&2; exit 1; }
  if [ -n "$iter" ]; then
    run="$(latest_run "$ver")"
    ck="$run/model_$iter.pt"
    [ -f "$ck" ] || { echo "체크포인트 없음: $ck" >&2; exit 1; }
  else
    ck="$(latest_ckpt "$ver")"
    [ -z "$ck" ] && { echo "체크포인트 없음: $ver" >&2; exit 1; }
  fi
  require_free_gpu
  cd "$PROJ"
  echo "측정: $ver  $(basename "$ck")  (약 7분)"
  "$IL" -p scripts/_isaaclab_launch.py scripts/gait_compare.py --task "$task" \
    --checkpoint "$ck" --num_envs 4 --num_steps 500 \
    --out "$HOME/odm_out/gait_$ver.npz" --headless 2>/dev/null | grep -E '^\[ok\]'
  "$IL" -p scripts/_isaaclab_launch.py scripts/joint_periodicity.py --task "$task" \
    --checkpoint "$ck" --num_envs 4 --num_steps 600 \
    --out "$HOME/odm_out/joint_$ver.npz" --headless 2>/dev/null | grep -E '^\[ok\]'
  "$IL" -p scripts/_isaaclab_launch.py scripts/imit_internals2.py --task "$task" \
    --checkpoint "$ck" --num_envs 16 --num_steps 200 --headless 2>/dev/null \
    | grep -E 'joint_pos sum|_rew|IMITATION|feet on|toggles|base speed'
  echo "npz: $HOME/odm_out/"
  ;;

watch)
  ver="${1:-v26}"; L="$RUNLOG/train_$ver.log"
  [ -f "$L" ] || { echo "로그 없음: $L" >&2; exit 1; }
  # 한 항목이라도 못 찾으면 grep 이 exit 1 을 내고 set -e 가 스크립트를 죽인다.
  # 전부 || true 로 감싸서, 없는 항목은 빈칸으로 두고 나머지는 보여준다.
  it=$(grep -a "Learning iteration" "$L" | tail -1 | sed 's/.*iteration //;s/ .*//;s/\x1b\[[0-9;]*m//g' || true)
  r=$(grep -a "Mean reward:" "$L" | tail -1 | sed 's/.*: //' || true)
  e=$(grep -a "Mean episode length:" "$L" | tail -1 | sed 's/.*: //' || true)
  # rsl-rl 2.x 는 "Mean action noise std:", 5.0.1 은 "Mean action std:" 로 찍는다.
  s=$(grep -aE "action (noise )?std:" "$L" | tail -1 | sed 's/.*: //' || true)
  eta=$(grep -a "ETA" "$L" | tail -1 | sed 's/.*: //' || true)
  # grep -c 는 0건일 때 exit 1 이라 set -e 가 스크립트를 죽인다. 즉 크래시가
  # 하나도 없는 정상 상황에서만 watch 가 조용히 실패했다.
  c=$(grep -acE "Traceback|illegal memory|RuntimeError" "$L" || true)
  ps_=$(awk -v r="$r" -v e="$e" 'BEGIN{if(e>0) printf "%.4f", r/e; else print "-"}')
  echo "$ver  iter $it | 스텝당 $ps_ (R $r / 에피 $e) | std $s | ETA $eta | 크래시 $c"
  ;;

tb)
  # v26부터만 겹친다. v25 이하는 rsl-rl 2.x에서 돌린 것이고 지금은 5.0.1이라
  # PPO 구현이 세 세대 다르다 — 같은 그래프에 놓으면 구현 차이를 알고리즘
  # 차이로 오독하게 된다 (인수인계 문서의 "스케일 착시"와 같은 함정).
  # 옛 런까지 보고 싶으면 임계값을 낮춰서 부르면 된다:  odm tb 1
  from="${1:-26}"
  pkill -9 -f tensorboard 2>/dev/null || true; sleep 2
  mkdir -p /tmp/tb; rm -f /tmp/tb/*
  for d in "$LOGROOT"/*imitation_v*; do
    [ -d "$d" ] || continue
    # 2026-07-30_02-35-26_imitation_v26 -> 26  (v20b 같은 접미사는 떼어낸다)
    n="$(basename "$d" | sed 's/.*_imitation_v//; s/[^0-9].*//')"
    [ -n "$n" ] || continue
    [ "$n" -ge "$from" ] 2>/dev/null || continue
    # 링크 이름에서 타임스탬프를 뗀다. 다만 **같은 버전을 여러 번 돌렸으면 이름이
    # 충돌해서 마지막 하나만 남는다** — ln -sfn 이 덮어쓰기 때문이다. 실제로
    # v33n 을 네 번 돌렸더니 텐서보드에 하나만 뜨고, 그것도 진행 중인 런이 아니라
    # 예전 것이었다 (2026-08-07). 중복이면 시각을 붙여 구분한다.
    base="$(basename "$d" | sed 's/.*_imitation/imitation/')"
    same=$(ls -d "$LOGROOT"/*"_${base#imitation_}" 2>/dev/null | wc -l)
    if [ "$same" -gt 1 ]; then
      # 2026-08-07_05-11-49_imitation_v33n -> imitation_v33n@0511
      base="${base}@$(basename "$d" | sed 's/^[0-9-]*_//; s/-[0-9]*_imitation.*//; s/-//')"
    fi
    ln -sfn "$d" "/tmp/tb/$base"
  done
  setsid nohup "$IL" -p -m tensorboard.main --logdir /tmp/tb --bind_all --port 6006 \
    > "$RUNLOG/tb.log" 2>&1 < /dev/null &
  echo "텐서보드: http://$(host_ip):6006   (v$from 이상 $(ls /tmp/tb | wc -l)개 런)"
  ;;

test)
  # 테스트는 Isaac Sim 없이 돌지만 torch 는 필요해서 Isaac 파이썬을 쓴다.
  # PYTHONPATH 를 걷어내는 이유: 이 PC 는 ROS Humble 이 깔려 있어
  # /opt/ros/humble/.../python3.10/site-packages 가 새어 들어오고, Isaac 의
  # python3.11 에서 lark 같은 걸 못 찾아 엉뚱한 곳에서 죽는다.
  cd "$PROJ"
  fail=0
  for t in tests/test_*.py; do
    if out=$(env -u PYTHONPATH "$IL" -p "$t" 2>&1); then
      printf "  ok    %s\n" "$(basename "$t")"
    else
      printf "  FAIL  %s\n" "$(basename "$t")"
      echo "$out" | tail -5 | sed 's/^/        /'
      fail=1
    fi
  done
  [ "$fail" -eq 0 ] && echo "전부 통과" || echo "실패 있음"
  exit "$fail"
  ;;

import)
  # OnShape -> URDF -> USD -> 색상, 한 번에. 예전에는 랩PC(do@192.168.137.111)에만
  # onshape-to-robot 과 API 키가 있어서 원격으로 돌려야 했는데, 2026-08-07 에
  # 둘 다 이 PC 로 옮겼다 (키는 ~/.onshape_env, 도구는 ~/.odm-tools).
  # 같은 워크스페이스로 양쪽에서 돌려 질량·링크·관절·색이 전부 동일함을 확인했다.
  TOOLS="$HOME/.odm-tools/bin"
  [ -f "$HOME/.onshape_env" ] || { echo "API 키가 없다: ~/.onshape_env" >&2; exit 1; }
  [ -x "$TOOLS/onshape-to-robot" ] || { echo "도구가 없다: $TOOLS/onshape-to-robot" >&2; exit 1; }
  cd "$PROJ"
  BK="$HOME/odm_out/robot_backup_$(date +%Y%m%d_%H%M%S)"
  mkdir -p "$(dirname "$BK")"; cp -r robot "$BK"
  echo "백업: $BK"
  echo "워크스페이스: $(grep -o 'w/[a-f0-9]*' robot/config.json)"
  set -a; . "$HOME/.onshape_env"; set +a
  "$TOOLS/onshape-to-robot" robot 2>&1 | tee "$RUNLOG/import.log" | tail -3
  echo
  L="$RUNLOG/import.log"
  # 무해한 same-name(STL 이름 자동 구분)만 남아야 정상이다. multiple base link 는
  # 어셈블리에 메이트 안 된 인스턴스가 있다는 뜻이고, 그 서브트리는 통째로 버려진다.
  printf "ERROR %s · no-mass %s · multiple-base %s · same-name %s · Traceback %s\n" \
    "$(grep -ci error "$L")" "$(grep -ci 'no mass' "$L")" \
    "$(grep -ci 'multiple base' "$L")" "$(grep -ci 'same name' "$L")" "$(grep -c Traceback "$L")"
  if [ "$(grep -ci 'multiple base' "$L")" != "0" ]; then
    echo "⚠️  메이트 안 된 인스턴스가 있다. Part Studio 의 Boolean 으로는 안 고쳐진다 —"
    echo "    어셈블리에서 Fastened mate 를 걸거나 인스턴스를 지울 것."
  fi
  "$TOOLS/python" - <<'PYEOF'
import xml.etree.ElementTree as ET
r = ET.parse("robot/robot.urdf").getroot()
links = r.findall("link")
jt = [j for j in r.findall("joint") if j.get("type") != "fixed"]
tot = sum(float(l.find("inertial").find("mass").get("value"))
          for l in links if l.find("inertial") is not None)
print(f"총질량 {tot:.4f} kg · 링크 {len(links)} · 가동관절 {len(jt)}")
PYEOF
  echo
  echo "USD 변환 중..."
  ISAACLAB_PATH="$(dirname "$IL")" ./scripts/setup/convert_urdf.sh --headless >/dev/null 2>&1 \
    && echo "USD 변환 완료" || { echo "USD 변환 실패" >&2; exit 1; }
  "$TOOLS/python" scripts/setup/inject_materials.py | grep -E "색 입힘|URDF 색"
  echo
  echo "다음: odm teleop --no-robot 으로 형상·색 확인, 그리고"
  echo "      ~/.odm-tools/bin/python scripts/diag/leg_trunk_clearance.py \\"
  echo "        --npz ~/odm_out/gait_v32.npz --urdf robot/robot.urdf --mesh-dir robot --stride 25"
  ;;

teleop)
  # 웹 슬라이더로 CAD 모델을 움직이고 실기가 따라오는지 보는 도구.
  # Isaac 이 아니라 pinocchio/meshcat 이 든 ~/.odm-tools 로 돈다.
  #
  # 여기 있는 이유: 레포가 SSD 에 있고 경로에 공백이 들어 있어서, 홈에서
  # `python scripts/hw/cad_teleop.py` 를 치면 파일을 못 찾는다. 실제로 그렇게
  # 한 번 막혔다. 어디서 쳐도 되게 하려는 것.
  TOOLS="$HOME/.odm-tools/bin/python"
  [ -x "$TOOLS" ] || { echo "도구 파이썬이 없다: $TOOLS  (./demo.sh setup)" >&2; exit 1; }
  cd "$PROJ"
  echo "먼저 잿슨에서 브리지를 띄워야 실기가 움직인다 (로봇은 매달아 놓을 것):"
  echo "  ssh -t parksuho@192.168.137.7 'python3 ~/dxl_bridge.py --arm'"
  echo "실기 없이 UI 만 보려면: odm teleop --no-robot"
  echo
  exec "$TOOLS" scripts/hw/cad_teleop.py "$@"
  ;;

refgait)
  # 레퍼런스 보행 한 주기를 실기 재생용 JSON 으로 뽑아 잿슨으로 보낸다.
  #   odm refgait               제자리
  #   odm refgait --vx 0.15     전진
  cd "$PROJ"
  out="/tmp/ref_gait.json"
  env -u PYTHONPATH "$IL" -p scripts/hw/export_ref_gait.py --out "$out" "$@" || exit 1
  scp -q "$out" scripts/hw/play_ref_gait.py parksuho@192.168.137.7:~/ \
    && echo && echo "잿슨으로 전송했다. 로봇을 매달아 놓고:" \
    && echo "  ssh -t parksuho@192.168.137.7 'python3 ~/play_ref_gait.py --speed 0.25 --cycles 3'"
  ;;

stop)
  pkill -9 -f "train.py" 2>/dev/null || true
  pkill -9 -f "play_fixed" 2>/dev/null || true
  sleep 3
  echo "정리 완료  (train $(ps aux|grep -c '[t]rain.py')  play $(ps aux|grep -c '[p]lay_fixed'))"
  ;;

list)
  printf "%-28s %-10s %s\n" "런" "최신 ckpt" "크기"
  # 경로에 공백이 있어 $(ls ...)를 for에 쓰면 단어 분리된다. glob을 직접 쓴다.
  ls -dt "$LOGROOT"/*imitation_* 2>/dev/null | head -12 | while IFS= read -r d; do
    ck=$(ls -t "$d"/model_*.pt 2>/dev/null | head -1)
    printf "%-28s %-10s %s\n" "$(basename "$d")" "$([ -n "$ck" ] && basename "$ck" || echo -)" "$(du -sh "$d" 2>/dev/null|cut -f1)"
  done
  ;;

*)
  cat <<'EOF'
odm — OpenDuck Mini 원스톱

  odm train  [ver] [iters] [envs]   학습 시작   (기본 v26 3000 4096)
  odm watch  [ver]                  진행 상황 한 줄
  odm play   [ver] [추가인자...]     재생 — 네이티브 창 (명령 순환, 오버레이, HUD)
  odm play   [ver] --stream         재생 — WebRTC (화면 없는 기계에서만)
  odm play   [ver] --joystick       재생 — Xbox 패드로 실시간 조종 (시간초과 리셋 없음)
                                   v32s = v32 정책 + 안전 필터 (실기 후보)
  odm measure[ver] [iter]           6방향·주기성·리워드 성분 (iter 주면 그 체크포인트)
  odm tb                            텐서보드 (전체 런 겹쳐보기)
  odm stop                          학습/재생 정리
  odm list                          런과 체크포인트 목록
  odm test                          테스트 전부 실행 (Isaac Sim 불필요)

  odm import                        OnShape -> URDF -> USD -> 색상 (백업 후 교체)

  ── 실기 (Jetson 192.168.137.7 의 U2D2. 로봇은 매달아 놓을 것) ──
  odm teleop [--no-robot]           웹 슬라이더로 CAD 를 움직이고 실기와 대조
  odm refgait [--vx 0.15 ...]       레퍼런스 보행을 뽑아 잿슨으로 전송

버전은 v13 v17 v24 v25 v26 처럼 주면 태스크가 자동으로 붙습니다.
GPU에 Isaac Sim 두 개가 동시에 뜨면 한쪽이 조용히 죽으므로 자동으로 막습니다.
EOF
  ;;
esac
